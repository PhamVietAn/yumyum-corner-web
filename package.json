{
  "name": "yumyum-corner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n PHP,CSS -c green,blue \"php -S localhost:8000\" \"npm run dev:css\"",
    "dev:css": "tailwindcss -i ./src/style.css -o ./public/tailwind.css --watch",
    "build:css": "tailwindcss -i ./src/style.css -o ./public/tailwind.css --minify",
    "dev:vite": "vite",
    "dev:php": "php -S localhost:8000",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "@tailwindcss/cli": "^4.2.2",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "chart.js": "^4.5.1",
    "daisyui": "^5.5.19"
  }
}
